# Copy to .env; never commit the real .env file.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=replace-with-a-new-long-random-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# MySQL connection (use MYSQL_URL instead if your host provides one)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=oasis_web
MYSQL_CONNECTION_LIMIT=10

# Prisma (required by db:migrate and db:seed)
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/oasis_web"

# Persistent uploads directory
DATA_DIR=./data
PUBLIC_SITE_URL=https://your-domain.example
