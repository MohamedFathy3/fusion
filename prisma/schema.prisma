generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id       Int    @id
  brand    String
  hero     String
  sections String
  contact  String
  content  String

  @@map("site_settings")
}

model ContentItem {
  collection String
  itemId     String @map("item_id")
  position   Int
  content    String

  @@id([collection, itemId])
  @@index([collection, position], map: "content_items_order")
  @@map("content_items")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  read      Boolean  @default(false)

  @@index([createdAt])
  @@map("contact_messages")
}
