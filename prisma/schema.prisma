generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model SiteSettings {
  id       Int    @id @db.UnsignedTinyInt
  brand    String @db.LongText
  hero     String @db.LongText
  sections String @db.LongText
  contact  String @db.LongText
  content  String @db.LongText

  @@map("site_settings")
}

model ContentItem {
  collection String @db.VarChar(32)
  itemId     String @map("item_id") @db.VarChar(191)
  position   Int
  content    String @db.LongText

  @@id([collection, itemId])
  @@index([collection, position], map: "content_items_order")
  @@map("content_items")
}
